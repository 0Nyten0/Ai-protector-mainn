{
  "manifest_version": 3,
  "name": "Ludomania AI Protector",
  "version": "1.0",
  "description": "AI-расширение для выявления тильта и игровой зависимости",
  "permissions": [
    "activeTab",
    "scripting", 
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "http://localhost:11434/*",
    "https://*.github.io/*",
    "file:///*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}